{
  "name": "pi-taskflow-monorepo",
  "version": "0.2.4",
  "private": true,
  "description": "Monorepo for taskflow-core, taskflow-control, taskflow-daemon, taskflow-cli, taskflow-mcp-core, taskflow-hosts, taskflow-dsl, taskflow-web, pi-taskflow, codex-taskflow, claude-taskflow, opencode-taskflow, grok-taskflow, and the documentation website.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "build": "pnpm run build:skills && pnpm --filter taskflow-core build && pnpm --filter taskflow-control build && pnpm --filter taskflow-web build && pnpm --filter taskflow-daemon build && pnpm --filter taskflow-cli build && pnpm --filter taskflow-mcp-core build && pnpm --filter taskflow-hosts build && pnpm --filter taskflow-dsl build && pnpm --filter pi-taskflow build && pnpm --filter codex-taskflow build && pnpm --filter claude-taskflow build && pnpm --filter opencode-taskflow build && pnpm --filter grok-taskflow build",
    "build:website": "cd website && npm run build",
    "build:skills": "node scripts/build-skills.mjs",
    "check:web-protocol-docs": "node --conditions=development --experimental-strip-types scripts/check-web-protocol-docs.mjs",
    "generate:web-protocol-docs": "node --conditions=development --experimental-strip-types scripts/check-web-protocol-docs.mjs --write",
    "check:web-cursor-vector": "node --conditions=development --experimental-strip-types scripts/check-web-cursor-vector.mjs",
    "generate:web-cursor-vector": "node --conditions=development --experimental-strip-types scripts/check-web-cursor-vector.mjs --write",
    "check:web-reference-fixtures": "node --conditions=development --experimental-strip-types scripts/generate-web-reference-fixtures.mjs",
    "check:web-render-evidence": "node scripts/check-web-render-evidence.mjs",
    "check:web-usability-materials": "node scripts/check-web-usability-materials.mjs",
    "check:web-candidate-evidence": "node scripts/check-web-candidate-evidence.mjs",
    "generate:web-reference-fixtures": "node --conditions=development --experimental-strip-types scripts/generate-web-reference-fixtures.mjs --write",
    "check:web-content": "node --conditions=development --experimental-strip-types scripts/check-web-content.mjs",
    "test:pack": "pnpm run build && node scripts/smoke-packed-packages.mjs",
    "typecheck": "tsc --noEmit",
    "test": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/*/test/*.test.ts'",
    "test:hosts": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-hosts/test/*.test.ts'",
    "test:pi": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/pi-taskflow/test/*.test.ts'",
    "test:codex": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/codex-taskflow/test/*.test.ts'",
    "test:claude": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/claude-taskflow/test/*.test.ts'",
    "test:opencode": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/opencode-taskflow/test/*.test.ts'",
    "test:grok": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/grok-taskflow/test/*.test.ts'",
    "test:dsl": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-dsl/test/*.test.ts'",
    "test:control": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-control/test/*.test.ts'",
    "test:daemon": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-daemon/test/*.test.ts'",
    "test:web": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-web/test/*.test.ts'",
    "test:web-node-matrix": "node scripts/test-web-node-matrix.mjs",
    "test:cli": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test 'packages/taskflow-cli/test/*.test.ts'",
    "test:e2e-web-console": "pnpm run build && node packages/taskflow-cli/test/e2e-web-console.mts",
    "test:e2e-web-console-chrome": "pnpm run build && TASKFLOW_WEB_BROWSER=chromium TASKFLOW_WEB_BROWSER_CHANNEL=chrome node packages/taskflow-cli/test/e2e-web-console.mts",
    "test:web-browser-matrix": "node scripts/test-web-browser-matrix.mjs",
    "test:web-packaged-compatibility": "node scripts/test-web-packaged-compatibility.mjs",
    "bench:web": "pnpm run build && node scripts/bench-web.mjs",
    "bench:web-smoke": "pnpm run build && node scripts/bench-web.mjs --smoke",
    "render:web-reference": "pnpm run build && node packages/taskflow-cli/test/render-web-reference.mts",
    "verify:web-candidate": "pnpm check:web-protocol-docs && pnpm check:web-cursor-vector && pnpm check:web-reference-fixtures && pnpm check:web-content && pnpm check:web-render-evidence && pnpm check:web-usability-materials && pnpm check:web-candidate-evidence && pnpm typecheck && pnpm test && pnpm test:pack && pnpm test:e2e-web-console",
    "test:workspace-baseline": "PI_TASKFLOW_BUILTIN_AGENTS_DIR= node --conditions=development --experimental-strip-types --test packages/taskflow-core/test/workspace-baseline.test.ts",
    "probe:workspace-hosts": "node scripts/workspace-probes/run.mjs",
    "test:e2e-codex": "node --conditions=development --experimental-strip-types packages/codex-taskflow/test/e2e-codex.mts",
    "test:e2e-codex-mcp": "node --conditions=development --experimental-strip-types packages/codex-taskflow/test/e2e-codex-mcp.mts",
    "test:e2e-codex-mcp-full": "pnpm run build && node --experimental-strip-types packages/codex-taskflow/test/e2e-mcp-comprehensive.mts",
    "test:e2e-claude": "node --conditions=development --experimental-strip-types packages/claude-taskflow/test/e2e-claude.mts",
    "test:e2e-claude-mcp": "node --conditions=development --experimental-strip-types packages/claude-taskflow/test/e2e-claude-mcp.mts",
    "test:e2e-opencode": "node --conditions=development --experimental-strip-types packages/opencode-taskflow/test/e2e-opencode.mts",
    "test:e2e-opencode-mcp": "node --conditions=development --experimental-strip-types packages/opencode-taskflow/test/e2e-opencode-mcp.mts",
    "test:e2e-grok": "node --conditions=development --experimental-strip-types packages/grok-taskflow/test/e2e-grok.mts",
    "test:e2e-grok-mcp": "node --conditions=development --experimental-strip-types packages/grok-taskflow/test/e2e-grok-mcp.mts",
    "test:e2e-pi-terminal-reap": "node --conditions=development --experimental-strip-types packages/pi-taskflow/test/e2e-terminal-reap.mts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@earendil-works/pi-agent-core": "^0.80.7",
    "@earendil-works/pi-ai": "^0.80.7",
    "@earendil-works/pi-coding-agent": "^0.80.7",
    "@earendil-works/pi-tui": "^0.80.7",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.15.0",
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  }
}
