{
	"name": "taskflow-mcp-core",
	"version": "1.0.0",
	"description": "Host-neutral Taskflow MCP server and DAG renderer, with bundled local control and project administration binaries. Shared by the Codex, Claude, OpenCode, Grok and Hermes adapters.",
	"keywords": [
		"taskflow",
		"mcp",
		"json-rpc",
		"orchestration",
		"subagents",
		"workflow"
	],
	"license": "MIT",
	"author": "heggria <bshengtao@gmail.com>",
	"homepage": "https://github.com/heggria/taskflow#readme",
	"bugs": {
		"url": "https://github.com/heggria/taskflow/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heggria/taskflow.git",
		"directory": "packages/taskflow-mcp-core"
	},
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/mcp/server.js",
	"types": "./dist/mcp/server.d.ts",
	"exports": {
		".": {
			"development": "./src/mcp/server.ts",
			"types": "./dist/mcp/server.d.ts",
			"default": "./dist/mcp/server.js"
		},
		"./server": {
			"development": "./src/mcp/server.ts",
			"types": "./dist/mcp/server.d.ts",
			"default": "./dist/mcp/server.js"
		},
		"./jsonrpc": {
			"development": "./src/mcp/jsonrpc.ts",
			"types": "./dist/mcp/jsonrpc.d.ts",
			"default": "./dist/mcp/jsonrpc.js"
		},
		"./svg": {
			"development": "./src/mcp/svg.ts",
			"types": "./dist/mcp/svg.d.ts",
			"default": "./dist/mcp/svg.js"
		}
	},
	"files": [
		"dist",
		"CONTROL_GUIDE.md"
	],
	"bin": {
		"taskflow-control": "./dist/control/control-cli.js",
		"taskflow-project-admin": "./dist/control/project-admin-cli.js"
	},
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node ../../scripts/build-control-bundle.mjs && node ../../scripts/copy-readme.mjs taskflow-mcp-core",
		"prepublishOnly": "npm run build"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/mcp/server.d.ts",
				"default": "./dist/mcp/server.js"
			},
			"./server": {
				"types": "./dist/mcp/server.d.ts",
				"default": "./dist/mcp/server.js"
			},
			"./jsonrpc": {
				"types": "./dist/mcp/jsonrpc.d.ts",
				"default": "./dist/mcp/jsonrpc.js"
			},
			"./svg": {
				"types": "./dist/mcp/svg.d.ts",
				"default": "./dist/mcp/svg.js"
			}
		}
	},
	"dependencies": {
		"taskflow-core": "workspace:*"
	},
	"peerDependencies": {
		"typebox": "*"
	}
}
