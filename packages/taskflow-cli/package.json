{
  "name": "taskflow-cli",
  "version": "0.3.0",
  "description": "taskflow CLI — admit/observe/cancel/resume against ControlHost (0.3 control plane).",
  "keywords": ["taskflow", "cli", "control-plane"],
  "license": "MIT",
  "author": "heggria <bshengtao@gmail.com>",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "taskflow": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "dependencies": {
    "taskflow-control": "workspace:*",
    "taskflow-core": "workspace:*"
  },
  "peerDependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "typebox": "^1.3.6",
    "typescript": "^7.0.2"
  }
}
